# Local Ledger - settings for the installation (copy to .env). Everything about the BOOKS (country, currency, model,
# categories, email inboxes) is set in the app itself: the first start shows a setup screen.

# --- who can reach it
# Password for the web UI and API. Leave empty only on your own computer or a private network (VPN).
LEDGER_PASSWORD=
# Address to listen on when using docker compose: 127.0.0.1 = this computer only, 0.0.0.0 = the whole network.
LEDGER_BIND=127.0.0.1
LEDGER_PORT=8890
# How the app is reached from a browser - used for download links and when another chat app connects to the tools.
LEDGER_URL=http://127.0.0.1:8890
# Extra host names / addresses the tool endpoint (/mcp) answers to, comma separated (e.g. 192.168.1.20,ledger.lan).
LEDGER_HOSTS=

# --- optional: preset answers for the setup screen (only used when the database is first created)
# LEDGER_COUNTRY=Denmark
# LEDGER_BASE_CURRENCY=DKK
# LEDGER_LLM_BASE_URL=http://host.docker.internal:11434/v1
# LEDGER_LLM_MODEL=
# LEDGER_LLM_API_KEY=
